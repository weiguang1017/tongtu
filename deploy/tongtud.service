# 通途服务端 systemd 单元(部署在公网服务器,Linux)
# 用法:
#   sudo cp tongtud /usr/local/bin/
#   sudo cp deploy/tongtud.service /etc/systemd/system/
#   编辑下方 ExecStart 里的域名/令牌/证书路径
#   sudo systemctl enable --now tongtud
[Unit]
Description=TongTu tunnel server (tongtud)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/tongtud \
  -domain example.com \
  -token CHANGE_ME \
  -control :7000 \
  -http :80 \
  -https :443 \
  -tls-cert /etc/tongtu/fullchain.pem \
  -tls-key /etc/tongtu/privkey.pem
Restart=always
RestartSec=3
# 允许非 root 绑定 80/443
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
DynamicUser=true

[Install]
WantedBy=multi-user.target
