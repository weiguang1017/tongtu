<?xml version="1.0" encoding="UTF-8"?>
<!-- 通途客户端 macOS 开机自启(LaunchAgent)—— headless 服务器/无图形场景用。
     桌面版用户请改用托盘菜单里的「开机自启」开关(自动管理
     ~/Library/LaunchAgents/com.tongtu.desktop.plist),不要与本模板同时启用,
     否则登录后会同时运行两份连接器。
     用法:
       cp bin/tongtu /usr/local/bin/
       先在终端完成配置: tongtu cred add / domain add / app add
       cp deploy/com.tongtu.client.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.tongtu.client.plist

     说明: `tongtu run` 会运行 ~/.tongtu/config.json 中全部已启用的应用;
     若只想跑单个端口且不落配置,可换回快捷模式参数
     (-name / -local,并在 EnvironmentVariables 里配 TONGTU_CF_TOKEN / TONGTU_DOMAIN)。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.tongtu.client</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tongtu</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/tmp/tongtu.log</string>
    <key>StandardErrorPath</key><string>/tmp/tongtu.log</string>
</dict>
</plist>
